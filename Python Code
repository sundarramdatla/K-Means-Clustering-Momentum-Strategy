def compute_atr(stock_data):
    atr = pandas_ta.atr(high=stock_data['high'], low = stock_data['low'], close = stock_data['close'], length = 14)
    return atr.sub(atr.expanding(min_periods=20).mean()).div(atr.expanding(min_periods=20).std())

df['atr'] = df.groupby(level=1, group_keys = False).apply(compute_atr)

def compute_macd(close):
    macd = pandas_ta.macd(close=close, fast=12, slow=26, signal=9).iloc[:,0]
    return macd.sub(macd.expanding(min_periods=20).mean()).div(macd.expanding(min_periods=20).std())

