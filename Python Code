def calculate_returns(df):
    df = df.copy()
    lags = [1, 2, 3, 6, 9, 12]

    for lag in lags:
        returns = df['adj close'].pct_change(
            periods=lag,
            fill_method=None
        )

        df[f'return_{lag}m'] = (
            returns.add(1).pow(1/lag).sub(1)
        )

    return df

