def optimize_weights(prices, lower_bound=0):
    returns = expected_returns.mean_historical_return(
        prices=prices,
        frequency=252
    )

    cov = risk_models.sample_cov(
        prices=prices,
        frequency=252
    )

    upper_bound = max(0.1, 1 / len(prices.columns))

    ef = EfficientFrontier(
        expected_returns=returns,
        cov_matrix=cov,
        weight_bounds=(lower_bound, upper_bound),
        solver='SCS'
    )

    ef.max_sharpe()

    return ef.clean_weights()

stocks = data.index.get_level_values('ticker').unique().tolist()

new_df = yf.download(
    tickers=stocks,
    start=data.index.get_level_values('date').min()
          - pd.DateOffset(months=12),
    end=data.index.get_level_values('date').max()
        + pd.offsets.MonthEnd(1)
        + pd.Timedelta(days=1),
    auto_adjust=False
)

prices = new_df['Adj Close']

print("Daily stock prices:", prices.shape)

returns_dataframe = prices.pct_change(fill_method=None)

portfolio_results = []

for start_date in fixed_dates.keys():
    try:
        start = pd.to_datetime(start_date)

        end_date = start + pd.offsets.MonthEnd(0)

        cols = fixed_dates[start_date]

        optimization_start_date = (
            start - pd.DateOffset(months=12)
        )

        optimization_end_date = (
            start - pd.DateOffset(days=1)
        )

        optimization_df = prices.loc[
            optimization_start_date:optimization_end_date,
            cols
        ].dropna(axis=1)

        cols = optimization_df.columns.tolist()

        if len(cols) == 0:
            continue

        success = False

        try:
            weights = optimize_weights(
                prices=optimization_df,
                lower_bound=round(1 / (len(cols) * 2), 3)
            )

            success = True

        except Exception as e:
            print(
                f'Max Sharpe Optimization failed for '
                f'{start_date}, continuing with equal weights'
            )

        if not success:
            weights = {
                ticker: 1 / len(cols)
                for ticker in cols
            }

        temp_df = returns_dataframe.loc[
            start:end_date, cols
        ]

        if temp_df.empty:
            continue

        temp_df = temp_df.dropna(axis=1)

        weight_series = (
            pd.Series(weights)
            .reindex(temp_df.columns)
            .fillna(0)
        )

        if weight_series.sum() <= 0:
            continue

        weight_series /= weight_series.sum()

        temp_df = (
            temp_df.mul(weight_series, axis=1)
            .sum(axis=1)
            .to_frame('Strategy Return')
        )

        portfolio_results.append(temp_df)

    except Exception as e:
        print(f"Error for {start_date}: {e}")

if not portfolio_results:
    raise ValueError("No portfolio returns were generated.")

portfolio_df = pd.concat(portfolio_results).sort_index()

